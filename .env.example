# Copie para .env. Nenhum segredo real deve ser versionado.
POSTGRES_USER=cattle
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cattlecount
# Opcional: exige o cabeçalho X-API-Key nas rotas que gravam (upload, contagem, exclusão). Vazio = sem chave (apenas rede local confiável).
API_KEY=
# Detecção: sliced (fatias de 1024 px nativos, recomendado para imagens de drone) | full
DETECT_MODE=sliced
DEFAULT_CONF=0.25
MAX_UPLOAD_MB=512
CORS_ORIGINS=http://localhost:8080
HTTP_PORT=8080
