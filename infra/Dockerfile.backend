# Nomes de imagem totalmente qualificados: funcionam em Docker e Podman.
FROM docker.io/library/python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY cattlecount ./cattlecount
COPY backend ./backend
ENV CATTLECOUNT_ROOT=/app DATA_DIR=/data/jobs PYTHONUNBUFFERED=1
RUN useradd -m app && mkdir -p /data/jobs && chown -R app /data
USER app
EXPOSE 8000
CMD ["uvicorn", "backend.app.asgi:app", "--host", "0.0.0.0", "--port", "8000"]
